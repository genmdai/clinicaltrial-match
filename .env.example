# Bedrock uses the standard AWS credential chain (not an API key) — configure via
# `aws configure` / SSO profile / env vars, not this file. These two are the only
# values the app itself needs, resolved live in Phase 0 (see CLAUDE.md §3).
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Bright Data (backend/tools/enrich_trial_access.py) — public-web enrichment only,
# never sent any patient data. Get the API key + zone names from your Bright Data
# account dashboard. Two zones are required: a SERP zone (Google search) and a
# Web Unlocker zone (page scraping) — see _brightdata_client.py for the request shape.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
